# Local infra (docker compose in this directory).
# Copy to infrastructure/.env and fill in. Never commit .env.
#
# LOCAL: required for `docker compose up` in this folder.
# VPS:   same keys; GUACAMOLE_JSON_SECRET_KEY MUST match backend/.env
#        (production direct-gateway). Do not reuse VPS secrets on a laptop.

# Guacamole Postgres container password
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
GUAC_DB_PASSWORD=

# Same 32 hex characters as backend/.env GUACAMOLE_JSON_SECRET_KEY
# LOCAL: can leave empty / unused while RDP_DIRECT_GATEWAY_MODE=off
# VPS:   required — generate once and copy to backend/.env identically
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
GUACAMOLE_JSON_SECRET_KEY=

# Optional — pin Guacamole image version for compose.media.yml
GUACAMOLE_VERSION=

# Media VPS compose (infrastructure/compose.media.yml).
# Copy to infrastructure/media/.env and fill in. Never commit .env.

# Match the SOURCE image version. Do not combine migration with an upgrade.
GUACAMOLE_VERSION=

# Guacamole Postgres password — quote values containing $ with single quotes.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
GUAC_DB_PASSWORD=

# Same 32 hex as backend GUACAMOLE_JSON_SECRET_KEY / infrastructure/.env
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
GUACAMOLE_JSON_SECRET_KEY=

# ╔══════════════════════════════════════════════════════════════╗
# ║       GlobalSolutions Platform — Backend Config Template     ║
# ║  Copy this file to .env and fill in your values.            ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Environment ───────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
ALLOWED_ORIGINS=http://localhost:3000

# Signed HttpOnly session cookie shared with the Next.js frontend (must match frontend .env.local)
SESSION_COOKIE_SECRET=change-me-to-a-long-random-string

# ── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_USE_PGBOUNCER=true

# ── Supabase Project (Auth & Admin API) ───────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Service role key (Settings → API → Project API keys → service_role)
SUPABASE_SECRET_KEY=your-supabase-service-role-key
# Optional: JWKS URL for RS256 token verification
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Optional: JWT Secret for HS256 token verification fallback
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Uptime Kuma (RDP TCP heartbeat) ─────────────────────────
UPTIME_KUMA_URL=http://localhost:3001
UPTIME_KUMA_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── Resend (email: payslips, broadcasts, notification emails) ─
# Create an API key at https://resend.com — app does NOT need to be hosted
# on the sending domain; only DNS (SPF/DKIM) must be verified in Resend.
RESEND_API_KEY=
# Must use a domain verified in Resend (e.g. noreply@yourdomain.com)
RESEND_FROM_EMAIL=GlobalSolutions <noreply@gsdeck.com>
# Signing secret of the Resend webhook that feeds delivery events (delivered,
# bounced, complained, opened) into the Email History page. Add a webhook in the
# Resend dashboard pointing at POST {API}/communications/resend/webhook and paste
# its whsec_ secret here. Leave empty to rely on the page's manual sync instead.
RESEND_WEBHOOK_SECRET=

# HMAC pepper for hashing deletion confirmation codes. Optional; falls back to
# RESEND_API_KEY. The plaintext code is never stored.
OTP_PEPPER=

# ── Gemini (Analytics inspection copy) ────────────────────────
# Google AI Studio API key. Leave empty to keep rule-only briefing text.
GOOGLE_API_KEY=
# Optional override. Default gemini-3.6-flash (current Google AI Studio flash).
GEMINI_MODEL=gemini-3.6-flash

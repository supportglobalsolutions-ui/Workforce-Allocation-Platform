# ╔══════════════════════════════════════════════════════════════╗
# ║  GlobalSolutions Platform — Backend Config Template          ║
# ║  Copy to backend/.env and fill in values. Never commit .env. ║
# ╚══════════════════════════════════════════════════════════════╝

# ── App ───────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
ALLOWED_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Signed HttpOnly session cookie (must match frontend SESSION_COOKIE_SECRET)
SESSION_COOKIE_SECRET=

# Fernet key for RDP credentials at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# ── PostgreSQL (Supabase) ─────────────────────────────────────
# Prefer session pooler :5432 for migrations; transaction :6543 for the app.
# Always include ?sslmode=require.
DATABASE_URL=
DATABASE_USE_PGBOUNCER=false

# ── Supabase Auth / Admin API ─────────────────────────────────
SUPABASE_URL=
# Preferred service key name (Settings → API → service_role)
SUPABASE_SECRET_KEY=
# Legacy alias — same value as SUPABASE_SECRET_KEY if you still use the old name
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe publishable / anon key (password recovery only on the API)
SUPABASE_PUBLISHABLE_KEY=
# Token verify: JWKS (RS256) preferred; JWT secret is HS256 fallback
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=

# Founder Super Admins (comma-separated). Cannot be deleted/banned/demoted.
PROTECTED_SUPER_ADMIN_EMAILS=

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── RDP session lifecycle ─────────────────────────────────────
RDP_DISCONNECT_GRACE_SECONDS=300
RDP_LIFECYCLE_INTERVAL_SECONDS=60
# false in production when using workforce-rdp-coordinator.service
RDP_RUN_COORDINATOR_IN_API=true
# 0 = unlimited (no numeric max-session cap). Positive = hard claim ceiling.
RDP_MAX_LIVE_SESSIONS=0
RDP_GATEWAY_CAPACITY=50
# JSON array of media nodes, or empty for single GUACAMOLE_PUBLIC_URL
# [{"id":"gw1","public_url":"https://guac1.example.com","private_url":"http://10.0.0.2:8080/guacamole","capacity":50}]
RDP_GATEWAYS=

# ── Phase 8 silent-failure guards ─────────────────────────────
RDP_ENDING_ESCALATE_SECONDS=90
RDP_DEGRADED_RECOVERY_SECONDS=300
RDP_SWEEP_CONFIRMATIONS=2
# Keep false until Phase 5 direct gateway is live
RDP_SWEEP_KILL_ORPHANS=false
RDP_GATEWAY_ADMIT_PER_SECOND=5

# ── Apache Guacamole (control-plane admin API) ────────────────
# LOCAL: Docker Guacamole on this machine (infrastructure/docker compose).
#   GUACAMOLE_URL=http://localhost:8080/guacamole
#   GUACAMOLE_PASSWORD= must match guacadmin in that local Guacamole UI
#   Keep RDP_DIRECT_GATEWAY_MODE=off so the browser uses the Python ws-tunnel.
# VPS:   GUACAMOLE_URL=http://127.0.0.1:8080/guacamole (private Tomcat only)
#   GUACAMOLE_PASSWORD= strong rotated password (never guacadmin)
GUACAMOLE_URL=http://localhost:8080/guacamole
GUACAMOLE_USERNAME=guacadmin
GUACAMOLE_PASSWORD=

# ── Direct Guacamole media plane (Phase 5) ────────────────────
# LOCAL (default): leave these empty / off — you do NOT need a public guac.
#   URL or a JSON key until you deliberately test the direct path.
#   RDP_DIRECT_GATEWAY_MODE=off
#   GUACAMOLE_PUBLIC_URL=
#   GUACAMOLE_JSON_SECRET_KEY=
#
# VPS / pilot: set all three to the SAME values used by Guacamole + nginx.
#   GUACAMOLE_PUBLIC_URL=https://guac.gsdeck.com
#   GUACAMOLE_JSON_SECRET_KEY=<32 hex, identical to infrastructure/.env>
#   RDP_DIRECT_GATEWAY_MODE=pilot
#   RDP_DIRECT_GATEWAY_PILOT_EMAILS=you@example.com
# Do NOT copy VPS pilot/on settings into local .env or the viewer will try
# wss://guac.gsdeck.com from your laptop and hang / “took too long”.
GUACAMOLE_PUBLIC_URL=
# 32 hex chars — same value as Guacamole JSON_SECRET_KEY / infrastructure/.env
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
GUACAMOLE_JSON_SECRET_KEY=
RDP_JOIN_TICKET_TTL_SECONDS=30
RDP_GUAC_SESSION_TTL_SECONDS=600
# off | pilot | on  — LOCAL should stay off unless testing direct canvas
RDP_DIRECT_GATEWAY_MODE=off
# Comma-separated emails when MODE=pilot (VPS only until you opt in locally)
RDP_DIRECT_GATEWAY_PILOT_EMAILS=

# ── Uptime Kuma ───────────────────────────────────────────────
UPTIME_KUMA_URL=http://localhost:3001
UPTIME_KUMA_WEBHOOK_SECRET=

# ── Resend email ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=GlobalSolutions <noreply@gsdeck.com>
RESEND_WEBHOOK_SECRET=
OTP_PEPPER=

# Bulk email dispatcher
EMAIL_DISPATCH_INTERVAL_SECONDS=5
EMAIL_DISPATCH_CLAIM_SIZE=100
EMAIL_DISPATCH_MAX_ATTEMPTS=3
EMAIL_DISPATCH_STUCK_MINUTES=10
EMAIL_DISPATCH_ENABLED=true

# ── FX rates ──────────────────────────────────────────────────
FX_API_URL=https://open.er-api.com/v6/latest

# ── Gemini (ops briefing) ─────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

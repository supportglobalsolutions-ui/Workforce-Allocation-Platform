# ╔══════════════════════════════════════════════════════════════╗
# ║  Frontend (Next.js) — copy to frontend/.env.local            ║
# ║  Never commit .env.local                                     ║
# ╚══════════════════════════════════════════════════════════════╝

# ── LOCAL vs production ───────────────────────────────────────
# LOCAL: leave NEXT_PUBLIC_API_URL blank (Next rewrites /api → backend).
#        SESSION_COOKIE_SECRET must match backend/.env exactly.
#        Keep ALLOW_GUACAMOLE_REMOTE_PROXY=false unless debugging Guacamole REST.
# Vercel/VPS frontend: set NEXT_PUBLIC_API_URL=https://api.gsdeck.com
#        Do NOT enable ALLOW_GUACAMOLE_REMOTE_PROXY (Phase 1 Safety).

# Public API origin (browser). Locally leave blank to use Next rewrites → /api.
NEXT_PUBLIC_API_URL=

# Dev-only: where Next proxies /api (defaults to http://127.0.0.1:8000)
API_PROXY_URL=

# Supabase browser client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Must match backend SESSION_COOKIE_SECRET (middleware session cookie)
# Mismatch → login “took too long” / workspace session errors.
SESSION_COOKIE_SECRET=
# Optional fallback for signing if SESSION_COOKIE_SECRET unset
OTP_PEPPER=

# Optional public Guacamole origin (legacy). Prefer backend GUACAMOLE_PUBLIC_URL
# in the join ticket for Phase 5. LOCAL: leave blank when MODE=off.
NEXT_PUBLIC_GUACAMOLE_URL=

# Dev only: enable Next /remote Guacamole proxy (never on Vercel/production)
ALLOW_GUACAMOLE_REMOTE_PROXY=false

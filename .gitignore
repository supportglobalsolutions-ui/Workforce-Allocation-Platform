.next/
out/
build/

# Production
build/
dist/

# Misc
.DS_Store
*.pem

# Python bytecode — never commit
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Local scratch / generated output
output/
tmp/
backend/email-template-server*.log
backend/email-template-server*.stdout.log

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
diag_*.txt
backend/server.stdout.log
backend/server.stderr.log
backend/email-template-server2.stderr.log
**/*.stderr.log

# Generated payslip PDFs
backend/data/payslips/

# Local env files — never commit secrets.
# Every .env* in every directory is ignored; the *.example templates are the
# only exception. Written this way so a new env file in a new location is
# covered by default rather than needing a rule added for it.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!**/.env.local.example

# Firebase service account key
**/firebase-service-account.json
firebase-service-account.json
**/admin.json
admin.json
**/serviceAccount*.json
**/service-account*.json
*-firebase-adminsdk-*.json

# Other credential material
*.key
*.p12
*.pfx
.firebase/

# Firebase security rules — copy-paste into Firebase Console, never commit
firestore.rules
storage.rules

# Env files in subdirectories
frontend/app/admin/.env

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
